rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS CONTROL (RBAC)
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }
    
    function getUserRole() {
      return hasUserData() ? getUserData().role : null;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isDirector() {
      return isAuthenticated() && (getUserRole() == 'director' || getUserRole() == 'mentor' || isAdmin());
    }
    
    function isAssistant() {
      return isAuthenticated() && (getUserRole() == 'assistant' || isDirector());
    }
    
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    // =========================================================================
    // COLLECTION SECURITY RULES
    // =========================================================================

    // 1. Users collection
    // Authenticated members can read member profiles.
    // Self-update allowed for profile details, but role and status elevation is blocked.
    // Assistants, Directors, and Admins can manage members.
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) ||
        isAssistant() || isDirector() || isAdmin()
      );
      allow delete: if isDirector() || isAdmin();
    }

    // 2. Tasks & Revision History collection
    // Students can read & submit progress on tasks assigned to them.
    // Assistants, Directors, and Admins can create, update, review, and delete tasks.
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        isAssistant() || isDirector() || isAdmin() ||
        resource.data.assignedStudentId == request.auth.uid ||
        resource.data.assignedStudentName == getUserData().name
      );
      allow create: if isAssistant() || isDirector() || isAdmin();
      allow update: if isAssistant() || isDirector() || isAdmin() || (
        isAuthenticated() && (
          resource.data.assignedStudentId == request.auth.uid ||
          resource.data.assignedStudentName == getUserData().name
        )
      );
      allow delete: if isAssistant() || isDirector() || isAdmin();
    }

    // 3. Attendance & Daily Logbook collection
    // Students can only read and create/update their own attendance record.
    // Assistants, Directors, and Admins can monitor, review, and audit all attendance.
    match /attendance/{attId} {
      allow read: if isAuthenticated() && (
        isAssistant() || isDirector() || isAdmin() ||
        resource.data.studentId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAssistant() || isDirector() || isAdmin() ||
        (
          isStudent() && 
          request.resource.data.studentId == request.auth.uid &&
          // BTP Geofence Bounding Box around (-6.970460, 107.630319)
          // Accommodates 250m radius (dLat ~0.0025, dLng ~0.0025) for full BTP building complex
          request.resource.data.latitude >= -6.9735 && request.resource.data.latitude <= -6.9675 &&
          request.resource.data.longitude >= 107.6270 && request.resource.data.longitude <= 107.6335 &&
          request.resource.data.locationRadius <= 300 &&
          request.resource.data.gpsAccuracy is number &&
          request.resource.data.gpsAccuracy > 0 && request.resource.data.gpsAccuracy <= 250 &&
          request.resource.data.checkInPhoto is string && request.resource.data.checkInPhoto.size() > 10 &&
          request.resource.data.status in ['present', 'late']
        )
      );
      allow update: if isAuthenticated() && (
        isAssistant() || isDirector() || isAdmin() ||
        (
          isStudent() && 
          resource.data.studentId == request.auth.uid && 
          request.resource.data.studentId == request.auth.uid &&
          // Cannot checkout twice
          (!('checkOutTime' in resource.data) || resource.data.checkOutTime == null) &&
          // Cannot tamper with original check-in parameters
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id', 'studentId', 'date', 'checkInTime', 'checkInTimestamp', 
            'status', 'latitude', 'longitude', 'checkInPhoto', 'locationRadius'
          ]) &&
          // Mandatory checkout fields
          request.resource.data.checkOutTime is string &&
          request.resource.data.checkOutTimestamp is number &&
          request.resource.data.dailyNotes is string && request.resource.data.dailyNotes.size() > 0
        )
      );
      allow delete: if isDirector() || isAdmin();
    }

    // 4. Announcements collection
    // All authenticated users can read.
    // Assistants, Directors, and Admins can publish, update, and delete announcements.
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAssistant() || isDirector() || isAdmin();
    }

    // 5. Approval Requests collection
    // Students can read and create their own approval requests.
    // Assistants, Directors, and Admins can view and approve/reject all requests.
    match /approval_requests/{reqId} {
      allow read: if isAuthenticated() && (
        isAssistant() || isDirector() || isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.studentName == getUserData().name
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAssistant() || isDirector() || isAdmin();
    }

    // 6. Notifications collection
    // Users can read notifications directed to everyone, their role, or their UID.
    // Assistants, Directors, and Admins can issue notifications.
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        isAssistant() || isDirector() || isAdmin() ||
        resource.data.recipientRole == 'all' ||
        resource.data.recipientRole == getUserRole() ||
        resource.data.recipientRole == request.auth.uid
      );
      allow create, update, delete: if isAssistant() || isDirector() || isAdmin();
    }

    // 7. System Logs collection
    // System audit logs read restricted to Assistants, Directors, and Admins.
    // Authenticated users can write log entries upon system actions.
    match /system_logs/{logId} {
      allow read: if isAssistant() || isDirector() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isDirector() || isAdmin();
    }

    // 8. Applicants (Recruitment) collection
    // Public creation allowed for prospective internship applicants.
    // Directors and Admins manage, advance stages, approve, or reject applicants.
    match /applicants/{appId} {
      allow read: if isAuthenticated();
      allow create: if true; // Public submission from Join Us form
      allow update, delete: if isAssistant() || isDirector() || isAdmin();
    }

    // 9. LMS Research Projects collection
    // Authenticated users can read research projects.
    // Assistants, Directors, and Admins can create, update, or archive projects.
    match /lms_projects/{lmsProjId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAssistant() || isDirector() || isAdmin();
    }

    // 10. Public Showcase Projects collection
    // Public read and sync write access for laboratory showcase pages.
    match /projects/{projId} {
      allow read, write: if true;
    }

    // 11. News & Articles collection
    // Public read and sync write access for laboratory news articles.
    match /news/{newsId} {
      allow read, write: if true;
    }

    // 12. Pending Registrations collection
    // Public creation allowed for prospective student registration.
    // Read allowed for status checking during login.
    // Update and delete allowed for managing and cleaning up registration records.
    match /pending_registrations/{regId} {
      allow create, read, update, delete: if true;
    }

  }
}
