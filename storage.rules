rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['assistant', 'director', 'mentor', 'admin'];
    }
    
    function isOwner(fileName) {
      return isAuthenticated() && (
        fileName.matches('selfie_' + request.auth.uid + '_.*') ||
        fileName.matches('.*_' + request.auth.uid + '_.*')
      );
    }
    
    // Avatars: Public read, authenticated upload
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Project Gallery Images: Public read, authenticated upload
    match /projects/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Attendance Selfie Photos:
    // Students can ONLY read and upload their OWN selfies.
    // Staff (Assistant, Pembina Lab, Admin) can read all selfies for monitoring.
    match /attendance/{fileName} {
      allow read: if isStaff() || isOwner(fileName);
      allow write: if (isStaff() || isOwner(fileName)) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
    
    // General Uploads: Public read, authenticated upload
    match /uploads/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
